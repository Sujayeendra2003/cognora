# COGNORA DIGITAL - Supabase Production Environment Variables
# Copy this file to .env and fill in your Supabase Project Credentials.
# Find your URL & Anon Key in Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-supabase-anon-key-here
